# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=postgres

# Zerodha Kite Connect
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_access_token

# TrueData
TRUEDATA_USER=your_truedata_username
TRUEDATA_PASSWORD=your_truedata_password

# Trading Parameters
INITIAL_CAPITAL=50000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=0.05
SCORE_THRESHOLD=0.6

# Model
MODEL_DIR=models/saved
MACRO_MODEL_PATH=models/saved/macro_model.pkl
MICRO_MODEL_PATH=models/saved/micro_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# LLM / AI Analysis (choose one provider)
# LLM_PROVIDER=openrouter|nemotron|openai|anthropic|gemini|ollama
LLM_PROVIDER=openrouter

# OpenRouter (free tier available, 100+ models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key

# NVIDIA Nemotron
# Get key at: https://build.nvidia.com/
NEMOTRON_API_KEY=your_nemotron_key

# OpenAI
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key

# Anthropic Claude
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key

# Google Gemini
# Get key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key

# Ollama (local, free, self-hosted)
# Install: https://ollama.ai/ then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
